.login { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:40rpx; }
.card { background-color:#fff; border-radius:32rpx; padding:80rpx 48rpx 48rpx; width:100%; max-width:640rpx; text-align:center; }
.title { font-size:48rpx; font-weight:700; display:block; }
.sub { color:#999; font-size:26rpx; margin-bottom:48rpx; display:block; margin-top:8rpx; }
.field { background-color:#f7f8fa; border-radius:20rpx; padding:24rpx 28rpx; margin-bottom:24rpx; display:flex; align-items:center; }
.label { font-size:28rpx; color:#666; width:120rpx; flex-shrink:0; }
.input { flex:1; font-size:28rpx; }
.agree { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; margin-bottom:24rpx; }
.cb { width:36rpx; height:36rpx; border:2rpx solid #ccc; border-radius:8rpx; margin-right:8rpx; display:flex; align-items:center; justify-content:center; font-size:22rpx; color:#fff; flex-shrink:0; }
.cb-on { background-color:#1989fa; border-color:#1989fa; }
.agree-text { font-size:24rpx; color:#666; }
.link { font-size:24rpx; color:#1989fa; }
.btn { margin-top:8rpx; background-color:#1989fa; color:#fff; border-radius:48rpx; font-size:32rpx; font-weight:600; }
.btn-dis { opacity:0.45; }
