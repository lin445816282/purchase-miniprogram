.reset { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:40rpx; }
.card { background-color:#fff; border-radius:32rpx; padding:60rpx 48rpx 48rpx; width:100%; max-width:640rpx; text-align:center; }
.title { font-size:48rpx; font-weight:700; display:block; }
.sub { color:#999; font-size:26rpx; margin-bottom:32rpx; display:block; margin-top:8rpx; }
.info-box { background:#fff7e6; border:1px solid #ffd666; border-radius:16rpx; padding:24rpx; margin-bottom:32rpx; }
.info-text { font-size:26rpx; color:#d48806; }
.btn { background-color:#1989fa; color:#fff; border-radius:48rpx; font-size:32rpx; font-weight:600; }
